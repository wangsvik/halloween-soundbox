{
  "name": {
    "en": "Halloween Soundbox",
    "no": "Halloween Soundbox"
  },
  "class": "speaker",
  "capabilities": ["onoff", "speaker_playing", "volume_set", "current_sound"],
  "capabilitiesOptions": {
    "onoff": {
      "title": { "en": "Ambience", "no": "Ambiens" }
    },
    "speaker_playing": {
      "title": { "en": "Effect playing", "no": "Effekt spiller" }
    }
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "discovery": "hwsoundbox",
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    { "id": "start" },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "prev": "start", "next": "add_devices" }
    },
    { "id": "add_devices", "template": "add_devices" }
  ],
  "settings": [
    {
      "type": "group",
      "label": { "en": "Connection", "no": "Tilkobling" },
      "children": [
        {
          "id": "address",
          "type": "text",
          "label": { "en": "IP address", "no": "IP-adresse" },
          "value": "",
          "hint": { "en": "Updated automatically when the soundbox is discovered.", "no": "Oppdateres automatisk når soundboxen blir funnet på nettverket." }
        },
        {
          "id": "port",
          "type": "number",
          "label": { "en": "Port", "no": "Port" },
          "value": 8080,
          "min": 1,
          "max": 65535
        },
        {
          "id": "api_key",
          "type": "password",
          "label": { "en": "API key", "no": "API-nøkkel" },
          "value": "",
          "hint": { "en": "Only if api_key is set in config.yaml on the Pi.", "no": "Kun hvis api_key er satt i config.yaml på Pi-en." }
        }
      ]
    }
  ]
}
